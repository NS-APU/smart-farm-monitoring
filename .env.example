# 環境変数の一覧（値は、明らかにダミーとわかるもの。実際の認証情報は、.env に書き、Git 管理に含めない）。
# このファイルは、ローカル開発用の例（PERSISTENCE=file・SEED_MODE=DEMO など、設定のスキーマの既定とは異なる値を含む）。
# 本番・共有環境では、そのままコピーしない（デモデータが入り、永続化される）。
# ローカル開発では、`pnpm dev:backend` が、.env があれば読み込む（node の --env-file-if-exists）。
# 説明は docs/10_design/functions/dev_spec.md 3章・4章。

# 実行形態: local（開発）／test（E2E・負荷テスト）／production（本番。アダプタ未実装のため起動できない）
APP_MODE=local
HOST=127.0.0.1
PORT=8787

# 開発用 API（/api/v1/dev/*。全データの消去・時計の操作・ジョブの強制実行を含む）。既定は無効（false）。
# E2E・負荷テストの設定（playwright.config.ts など）でだけ true にする。production では、指定にかかわらず無効
# DEV_API_ENABLED=false
# 信頼するプロキシの段数（0〜10）。0（既定）は、X-Forwarded-For を信頼しない。N は、末尾から N 番目の値（信頼するプロキシが付けた値）を、
# ログインの試行回数の制限の接続元とみなす。プロキシの経路が確定してから指定する（dev_spec.md 3.3）
# TRUSTED_PROXY_HOPS=0

# データの保持: memory（メモリのみ）／file（DATA_FILE の JSON ファイル）／dynamodb（DynamoDB。下の設定が必要）
PERSISTENCE=file
DATA_FILE=.local-data/store.json
# 認証の方式: local（アプリ内。既定）／cognito（Amazon Cognito。ADR-0008）。cognito は、PERSISTENCE=dynamodb が必要で、
# INITIAL_USER_* とは同時に使えない（最初のユーザーは、pnpm initial-user で作る。docs/00_project/commands.md）
# AUTH_PROVIDER=local
# AUTH_PROVIDER=cognito のとき（値は、SfmData のスタックの出力）:
# COGNITO_USER_POOL_ID=
# COGNITO_CLIENT_ID=
# PERSISTENCE=dynamodb のとき: テーブル名（必須）。DYNAMODB_ENDPOINT は、DynamoDB Local など、ローカルの確認用（指定すると、起動時にテーブルを作る。
# AWS では指定しない）。DEV_API_ENABLED とは、同時に使えない（手順は docs/00_project/commands.md の「DynamoDB Local」）
# DYNAMODB_OBSERVATIONS_TABLE=dev-observations
# DYNAMODB_MAIN_TABLE=dev-main
# DYNAMODB_ENDPOINT=http://127.0.0.1:18000
# ファイルサーバーのモックのルート。<ルート>/robot/ と <ルート>/environment-sensor/ に合成データを置く
FILE_SERVER_DIR=.local-data/file-server

# 初期データ: NONE／DEMO（デモの設備・合成データ・評価を投入する）
SEED_MODE=DEMO
# SEED_MODE=DEMO の合成データの日数（1〜31。既定 3）
# DEMO_SEED_DAYS=3

# 最初のユーザー（ユーザーが1人もいないときだけ作成する）。以下はダミー値
INITIAL_USER_ID=local-user
INITIAL_USER_NAME=ローカル開発ユーザー
INITIAL_USER_PASSWORD=Dummy-Passw0rd-local
# ロール定義（JSON。省略すると、1ロール「worker（農作業者）」が、全権限（ユーザー管理・変更履歴の参照を含む）を持ち、起動時に警告を出す）と、
# 初期ユーザーのロール（省略すると、ユーザー管理の権限を持つ最初のロール）。共有・本番の環境では、権限を分けたロール定義を指定する
# ROLE_DEFINITIONS_JSON={"admin":{"name":"管理者","permissions":["user:manage"]},"viewer":{"name":"閲覧者","permissions":[]}}
# INITIAL_USER_ROLE=admin

# スケジューラ（取り込み・評価・連携・通知の配信）をサーバー内で動かすか
SCHEDULER_ENABLED=true
SCHEDULER_TICK_SECONDS=30

LOG_LEVEL=info
# 取得間隔の既定値（分。5／15／30／60／360／1440）と、「データが古い」の基準（取得間隔の何倍か）
DEFAULT_INGESTION_INTERVAL_MINUTES=15
STALE_AFTER_INTERVALS=3
INGESTION_RETRY_BASE_DELAY_MS=1000

# Web Push の購読に使う公開鍵（VAPID。65バイトの公開鍵の base64url。値はダミー。未指定なら、Web Push の購読を受け付けない）
# WEB_PUSH_PUBLIC_KEY=ZHVtbXktd2ViLXB1c2gtcHVibGljLWtleS1mb3ItZTJlLTAxMjM0NTY3ODktYWJjZGVmZ2hpamtsbW5vcC1xcnM

# 接続先の認証情報の参照名ごとの値（SecretPort。環境変数 SECRET_<参照名>）。モックには不要
# SECRET_FILE_SERVER_MOCK=dummy-secret
